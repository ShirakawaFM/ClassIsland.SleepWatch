<Project Sdk="Microsoft.NET.Sdk">

  <!-- 两套构建，同一份源码：
       默认打正式版（2.1.0.1 / net8 / Avalonia 11），
       -p:PreviewBuild=true 打 2.2 预览版（2.1.1.1 / net10 / Avalonia 12）。
       必须分开打：Avalonia 的 XAML 编译产物和运行时版本强绑定，
       11 编出来的 XAML 在 12 里会在 DynamicResourceExtension 上炸，反之亦然。 -->
  <PropertyGroup Condition="'$(PreviewBuild)' == 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PreviewBuild)' != 'true'">
    <!-- 必须钉在正式版的框架上，别跟着预览版跑：
         ClassIsland 2.1.0.1（当前 Latest）是 net8.0 宿主，2.2 预览版（2.1.1.x / 2.1.2.0）才升到 net10。
         插件 TFM 高于宿主就加载不起来，这是硬约束，不是配置问题。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ClassIsland.SleepWatch</AssemblyName>
    <RootNamespace>ClassIsland.SleepWatch</RootNamespace>
    <Version>1.5.1.0</Version>
    <AssemblyTitle>SleepWatch 课堂睡意监测</AssemblyTitle>
    <Product>SleepWatch</Product>
    <Company>ShirakawaFM</Company>
    <Authors>ShirakawaFM / 白川方明</Authors>
    <Copyright>© 2026 ShirakawaFM / 白川方明</Copyright>
    <Description>按连续静置时长判断谁睡着了：静置进疑似、撑够才确认，主界面显示确认沉睡人数与抬头率。</Description>
    <RepositoryUrl>https://github.com/ShirakawaFM/ClassIsland.SleepWatch</RepositoryUrl>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- 像素背景直接往 WriteableBitmap 的帧缓冲里写，省掉上万次托管调用 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 打包 cipx 请用项目根目录的 pack.cmd，不要直接 -p:CreateCipx=true。
         原因：SDK 的 targets 会强制把 PowershellBinaryName 重置成 pwsh（PowerShell Core），
         写在 csproj 里会被覆盖，只能通过命令行全局属性传进去。 -->
  </PropertyGroup>

  <ItemGroup Condition="'$(PreviewBuild)' == 'true'">
    <!-- 2.2 预览版：SDK 2.1.1.1（档案模型改过，必须用这版编），Avalonia 12 带的是 SkiaSharp 3.x -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(PreviewBuild)' != 'true'">
    <!-- 正式版 2.1.0.1：apiVersion 也要跟着写 2.1.0.1，
         加载器只认「插件 apiVersion ≤ 本体版本」，写高了正式版会直接拒收。
         快照要往图上写中文，OpenCV 自带的 Hershey 字体只有 ASCII；
         SkiaSharp 必须和宿主 Avalonia 11.3.17 用的版本一致（2.88.9）。 -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.0.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 插件市场列表和插件详情页都按这个文件名找图标 -->
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 模型随插件一起分发，部署时不需要联网下载 -->
    <None Update="models\**\*.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 打包前剔除用不上的原生库：
       本项目只编译 x64，win-x86 / win-arm64 / osx / linux 那几套全是白撑包体。
       SkiaSharp 的 native assets 会带上 arm64、macOS、Linux 几套原生库，必须一起清掉。 -->
  <Target Name="PruneX86Runtime" BeforeTargets="CreateCipx" Condition="'$(CreateCipx)' == 'true'">
    <ItemGroup>
      <PruneRuntimeDir Include="$(OutputPath)runtimes\win-x86" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\win-arm64" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\osx" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\osx-x64" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\osx-arm64" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\linux" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\linux-x64" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\linux-arm" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\linux-arm64" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\linux-musl-x64" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\browser-wasm" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\android" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\ios" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\maccatalyst" />
      <PruneRuntimeDir Include="$(OutputPath)runtimes\tvos" />
    </ItemGroup>
    <RemoveDir Directories="@(PruneRuntimeDir)" />
    <!-- 原生库的调试符号（libSkiaSharp.pdb 一个就 81MB）对运行毫无用处，直接丢掉 -->
    <ItemGroup>
      <NativeSymbolFile Include="$(OutputPath)runtimes\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(NativeSymbolFile)" />
    <Message Text="已剔除非 win-x64 的原生库目录与原生 PDB" Importance="high" />
  </Target>

</Project>
