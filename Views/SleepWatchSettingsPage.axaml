<ci:SettingsPageBase
    x:Class="ClassIsland.SleepWatch.Views.SleepWatchSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="SleepWatch 睡意监测" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="原理：按“连续多久没有有效动作”判断。动一下（抬头、转身、举手、睁眼）计时就清零；一直不动先记作疑似，撑够确认时长才写成正式记录。不绑定固定姿势，趴桌、侧脸、后排远距离都能用。纯娱乐用途，数字别当真。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

            <!-- ================= 实时画面 ================= -->
            <TextBlock Text="实时画面" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Border BorderThickness="1" BorderBrush="#33888888" CornerRadius="6" Background="#1A000000" Padding="8">
                <StackPanel Spacing="8">
                    <Grid Height="320">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="监测未运行，先点下面的【重启监测】"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Opacity="0.55" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock x:Name="PreviewInfo" Text="—" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#78DC78" VerticalAlignment="Center" />
                    <TextBlock Text="清醒" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#F0A030" VerticalAlignment="Center" />
                    <TextBlock Text="疑似（框上有进度条）" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#E05050" VerticalAlignment="Center" />
                    <TextBlock Text="确认沉睡" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#5A9CF0" VerticalAlignment="Center" />
                    <TextBlock Text="老师（不计入）" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#C8C85A" VerticalAlignment="Center" />
                    <TextBlock Text="判断不了（背对 / 被挡 / 太远）" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <CheckBox x:Name="PreviewToggle" Content="显示实时画面（关掉可省一点 CPU）" IsChecked="True" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartButton" Content="重启监测" />
                <Button x:Name="StopButton" Content="停止" />
                <Button x:Name="ResetButton" Content="清空所有人状态" />
                <Button x:Name="FolderButton" Content="打开配置目录" />
            </StackPanel>

            <Border BorderThickness="1" BorderBrush="#33888888" CornerRadius="6" Padding="12">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- ================= 摄像头 ================= -->
            <TextBlock Text="摄像头" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="本机设备" Width="110" VerticalAlignment="Center" />
                <ComboBox x:Name="CameraCombo" Width="330" PlaceholderText="点【刷新】列出本机摄像头" />
                <Button x:Name="CameraRefreshButton" Content="刷新" />
            </StackPanel>
            <TextBlock x:Name="CameraHint" Text="点【刷新】逐个试开一遍设备，能开的才会列出来。挑一个会自动填进下面的视频源。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="视频源" Width="110" VerticalAlignment="Center" />
                <TextBox x:Name="SourceBox" Width="300"
                         ToolTip.Tip="0 = 本机摄像头；也可填 rtsp:// 或 http:// 地址" />
            </StackPanel>
            <TextBlock Text="填序号（0 = 本机默认摄像头），或者 rtsp:// / http:// 地址。"
                       FontSize="12" Opacity="0.6" Margin="122,0,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="处理帧率" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="FpsSlider" Width="260" VerticalAlignment="Center"
                        Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="FpsValue" Text="4" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="帧/秒，4 已经够用" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="推理宽度" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="WidthSlider" Width="260" VerticalAlignment="Center"
                        Minimum="320" Maximum="1920" TickFrequency="80" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="WidthValue" Text="640" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="像素，卡就调小" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ================= 班级 ================= -->
            <TextBlock Text="班级" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="应到人数有两个用处：算“画面里还差几个人”，以及当检测的人数上限——多出来的框（反光、海报上的人、隔壁班路过）直接丢掉。0 表示不限制。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="应到人数" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="ClassSizeSlider" Width="260" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="ClassSizeValue" Text="45" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock x:Name="ClassSizeHint" Text="人" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ================= 判定参数 ================= -->
            <TextBlock Text="判定参数" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="判定不看姿势，看“连续多久没有有效动作”。动一下（抬头、转身、举手、睁眼）静置计时就清零，只有一直不动才往“疑似→确认”走。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="静置判定" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="SleepSlider" Width="260" VerticalAlignment="Center"
                        Minimum="2" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="SleepValue" Text="8" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="秒。连续这么久没有任何动作，进入“疑似”" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="沉睡确认" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="ConfirmSlider" Width="260" VerticalAlignment="Center"
                        Minimum="5" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="ConfirmValue" Text="30" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="秒。疑似再持续这么久才写正式记录 + 抓快照" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="姿态加权" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="PostureSlider" Width="260" VerticalAlignment="Center"
                        Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="PostureValue" Text="0.60" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="低头又没睁眼时，判定时长乘这个系数（越小越快）" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="LegacyPostureBox" Content="经典姿态判定（1.4 的老规则：低头 / 闭眼直接算睡着）" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="在座记忆" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="PresenceSlider" Width="260" VerticalAlignment="Center"
                        Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="PresenceValue" Text="6" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="分钟。多久没看到脸就不再算“在座”" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="睁眼阈值" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="EyeSlider" Width="260" VerticalAlignment="Center"
                        Minimum="0.02" Maximum="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="EyeValue" Text="0.10" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="越大越难判成睁眼。对照上面的实时画面调" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="机位预设" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="教室机位差别很大，同一套阈值不可能都合适。选一个最接近的，插件会把置信度、低头阈值、匹配宽容度一起调好；套完还可以继续手动微调。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="当前机位" Width="110" VerticalAlignment="Center" />
                <ComboBox x:Name="PresetCombo" Width="260" />
            </StackPanel>
            <TextBlock x:Name="PresetNote" Text="—" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

            <!-- ================= 多人跟踪与环境 ================= -->
            <TextBlock Text="多人跟踪与环境" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="每个人有自己的编号和计时，互不影响。趴桌把脸埋进胳膊、侧脸、后排远距离、讲台两侧侧身，都靠下面这几项兜住。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="遮挡续踪" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="OcclusionSlider" Width="260" VerticalAlignment="Center"
                        Minimum="2" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="OcclusionValue" Text="12" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="秒。整个人被挡住时，编号保留这么久不重置计时" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="漏检缓存" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="CacheSlider" Width="260" VerticalAlignment="Center"
                        Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="CacheValue" Text="6" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="秒。偶尔漏检、侧身闪一下，靠它接回原来那个人" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="讲台区域" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="PodiumSlider" Width="260" VerticalAlignment="Center"
                        Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="PodiumValue" Text="20" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="% 画面上方这一段算讲台，站在里面的人优先判成老师" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="ExcludeTeacherBox" Content="自动排除老师（站立、走动、讲台区的人不计入沉睡和抬头率）" />
            <CheckBox x:Name="SingleEyeBox" Content="单眼可判（侧脸只有一只眼看得见时，也拿来判断）" />
            <CheckBox x:Name="TrustPostureBox" Content="后排多信姿态（人很小、眼睛只有几个像素时，别硬看眼睛）" />

            <!-- ================= 推理开销 ================= -->
            <TextBlock Text="推理开销" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <CheckBox x:Name="ChunkBox" Content="分块推理（每帧只算一个块，四帧覆盖全画面，单帧开销砍一半）" />
            <CheckBox x:Name="MicThrottleBox" Content="麦克风被占用时自动降频（上网课、录音的时候给别人让路，之后自动恢复）" />

            <!-- ================= 证据快照 ================= -->
            <TextBlock Text="证据快照" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="只在“确认沉睡”的那一刻抓一张局部裁剪图，带上课程名、时间、编号和入睡时间段。不存整幅画面、不提取人脸特征、不联网。疑似和中途醒来都不存。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <CheckBox x:Name="SnapshotBox" Content="保存证据快照（默认关；开了才会往本机硬盘写图）" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="存放目录" Width="110" VerticalAlignment="Center" />
                <TextBox x:Name="SnapshotFolderBox" Width="330"
                         ToolTip.Tip="留空 = 配置目录下的 snapshots" />
                <Button x:Name="SnapshotPickButton" Content="选择…" />
                <Button x:Name="SnapshotOpenButton" Content="打开" />
            </StackPanel>
            <TextBlock Text="留空就用配置目录下的 snapshots。换个盘符或移动硬盘都行，路径不通会自动退回默认目录。"
                       FontSize="12" Opacity="0.6" Margin="122,0,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="保留天数" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="SnapshotDaysSlider" Width="260" VerticalAlignment="Center"
                        Minimum="7" Maximum="365" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="SnapshotDaysValue" Text="120" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="天。超期的自动删掉" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="图片质量" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="SnapshotQualitySlider" Width="260" VerticalAlignment="Center"
                        Minimum="40" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="SnapshotQualityValue" Text="70" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="JPEG 质量，低一点省盘" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SnapshotUsageText" Text="占用：—" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

            <!-- ================= 课表同步 ================= -->
            <TextBlock Text="课表同步" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="按 ClassIsland 的课表时间自动判断上课 / 下课：每一拍都拿当前时间去课表里查，不依赖下课铃事件，所以就算事件漏了、课表被手动跳了，也不会整节课不记账。下课时刻取课表上写的时间，不是插件醒来的时间。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

            <Border BorderThickness="1" BorderBrush="#33888888" CornerRadius="6" Padding="14">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="PhaseDot" Width="10" Height="10" CornerRadius="5"
                                Background="#9E9E9E" VerticalAlignment="Center" />
                        <TextBlock x:Name="PhaseTitle" Text="正在读取课表…" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PhaseDetail" Text="—" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="PhaseNext" Text="" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                    <Border Height="1" Background="#22888888" Margin="0,3" />
                    <TextBlock x:Name="SyncStatus" Text="—" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" />
                    <TextBlock x:Name="ClockWarning" Text="" FontSize="11.5" Foreground="#C08040"
                               TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SyncButton" Content="立即同步课表" />
                <Button x:Name="SimulateClassButton" Content="模拟上课" />
                <Button x:Name="SimulateBreakButton" Content="模拟下课" />
            </StackPanel>

            <!-- ================= 试弹 ================= -->
            <TextBlock Text="结果试弹" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="等一节课太慢，这里可以立刻把总结窗弹出来看真实效果。弹出来的窗口是正常窗口，能改配色、能勾选显示项、按 Esc 直接关；试弹全程不写历史记录，弹多少次都不会污染数据。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="PreviewLiveButton" Content="试弹（真实记录）" />
                <Button x:Name="PreviewSampleButton" Content="试弹（合成数据）" />
                <Button x:Name="PreviewRerollButton" Content="换一版再弹" />
            </StackPanel>

            <Border BorderThickness="1" BorderBrush="#33888888" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PreviewStatus" Text="还没试弹过" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="合成数据用固定种子生成，同样的种子每次都长一样，方便对照改配色前后的差别。"
                               FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ================= 自动化 ================= -->
            <TextBlock Text="自动化" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <CheckBox x:Name="AutoStartBox" Content="上课自动开始监测" />
            <CheckBox x:Name="AutoStopBox" Content="下课 / 放学自动停止（摄像头句柄一起释放）" />

            <TextBlock Text="只在这些课自动开" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="全不勾 = 每节课都开。勾了就只有勾到的科目自动开；手动点【重启监测】不受这个限制，随时能开。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <WrapPanel x:Name="SubjectPanel" />

            <!-- ================= 课后总结 ================= -->
            <TextBlock Text="课后总结" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="检测在后台安静记账：谁睡着了、睡了多久、什么时候醒的。下课后自动弹出总结窗口，按天翻页看历史；嫌下课那阵太乱，可以让它晚几秒再出来。窗口里能改配色和显示项。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <CheckBox x:Name="SilentBox" Content="静默检测（主界面不显示人数，只在课后出报告）" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="延迟弹出" Width="110" VerticalAlignment="Center" />
                <Slider x:Name="PopupDelaySlider" Width="260" VerticalAlignment="Center"
                        Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="PopupDelayValue" Text="0" Width="46" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock x:Name="PopupDelayHint" Text="秒。0 就是下课立刻弹" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SummaryButton" Content="打开课后总结" />
                <Button x:Name="SampleSummaryButton" Content="看示例效果" />
            </StackPanel>

            <TextBlock Text="提示：拖动滑动条会自动保存。检测参数要生效还得点【重启监测】；延迟弹出、配色这类改完下一节课就按新的来。灯光变化大或者逆光时，回来对照实时画面重调一次睁眼阈值。"
                       FontSize="12" Opacity="0.55" TextWrapping="Wrap" Margin="0,4,0,0" />

            <!-- ================= 诊断 ================= -->
            <TextBlock Text="诊断" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="日志写在配置目录的 logs 下，按天一个文件、超过 2MB 自动换一个。默认只留警告和错误，排问题时再调成“调试”。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="日志级别" Width="110" VerticalAlignment="Center" />
                <ComboBox x:Name="LogLevelCombo" Width="180" />
                <Button x:Name="LogFolderButton" Content="打开日志目录" />
            </StackPanel>

            <!-- ================= 关于 ================= -->
            <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Border BorderThickness="1" BorderBrush="#33888888" CornerRadius="6" Padding="14">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="SleepWatch 课堂睡意监测" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="#22888888" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="v1.1.0" FontSize="11" Opacity="0.8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="作者：ShirakawaFM / 白川方明" FontSize="12" Opacity="0.75" />
                    <TextBlock Text="接一个教室摄像头，按“连续静置时长”反推画面里有几个人睡着了。画面只在本机内存里过一遍，不联网、不做人脸识别、不认人；不开证据快照就不往硬盘写任何一帧，开了也只存判定那一刻的局部裁剪图。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                        <Button x:Name="RepoButton" Content="项目主页" />
                        <Button x:Name="LicenseButton" Content="MIT 许可" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="纯娱乐向插件，数字仅供参考。"
                       FontSize="12" Opacity="0.45" TextWrapping="Wrap" Margin="0,2,0,14" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
