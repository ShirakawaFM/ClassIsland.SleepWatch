<Window
    x:Class="ClassIsland.SleepWatch.Views.SummaryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:ClassIsland.SleepWatch.Controls"
    Title="SleepWatch 课后总结"
    Width="920" Height="640"
    MinWidth="820" MinHeight="560"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    Background="#F7F4EC"
    FontFamily="Segoe UI, Microsoft YaHei">

    <!--
        整页的颜色只在 ApplyTheme() 里换，换法是替换这几个画刷资源。
        下面的样式把它们绑到每一种文字控件上，所以配置面板里的标题、勾选项、
        输入框、滑块标签都会跟着主题走 —— 这些控件没有自己的 x:Name，
        早先是靠"什么都不设"吃 ClassIsland 的主题色，主程序一旦是深色模式，
        白字就落在浅色底上，整片看不见。
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="SwText" Color="#2E2A26" />
        <SolidColorBrush x:Key="SwTextSoft" Color="#2E2A26" />
        <SolidColorBrush x:Key="SwTextDim" Color="#2E2A26" />
        <SolidColorBrush x:Key="SwTextFaint" Color="#2E2A26" />
        <SolidColorBrush x:Key="SwAccent" Color="#D97757" />
        <SolidColorBrush x:Key="SwField" Color="#F5F1E8" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SwText}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource SwText}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SwText}" />
            <Setter Property="Background" Value="{DynamicResource SwField}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SwText}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SwTextSoft}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SwText}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource SwAccent}" />
            <Setter Property="Foreground" Value="#FFF9F4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- 勾选框默认是系统蓝，跟整页配色不搭，改成主题色 -->
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource SwAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SwAccent}" />
        </Style>
        <Style Selector="TextBox.hex">
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="104" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- 会流动的像素背景（60fps，跟着垂直同步走） -->
        <ctrl:PixelFlowBackground x:Name="Flow" />

        <Grid Margin="22">
            <Border x:Name="Shell"
                    CornerRadius="20"
                    Background="#DEFFFCF6"
                    BorderThickness="1"
                    BorderBrush="#33D97757">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- ================= 顶栏 ================= -->
                    <Grid Grid.Row="0" Margin="26,18,18,6" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="LogoBox" Width="32" Height="32" CornerRadius="9" Background="#D97757">
                                <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" Margin="7">
                                    <Border Grid.Row="0" Grid.Column="0" Background="#FFF4EE" CornerRadius="1" />
                                    <Border Grid.Row="0" Grid.Column="2" Background="#FFF4EE" CornerRadius="1" />
                                    <Border Grid.Row="1" Grid.Column="1" Background="#FFF4EE" CornerRadius="1" />
                                    <Border Grid.Row="2" Grid.Column="0" Background="#FFF4EE" CornerRadius="1" />
                                    <Border Grid.Row="2" Grid.Column="2" Background="#FFF4EE" CornerRadius="1" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="HeaderTitle" Text="课后总结" FontSize="14.5" FontWeight="Bold" />
                                <TextBlock x:Name="HeaderSub" Text="静默检测 · 全程无打扰" FontSize="10.5" Opacity="0.48" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Classes="tool" Content="‹" FontSize="15" Padding="11,1" />
                            <Button x:Name="PlayButton" Classes="tool" Content="暂停" />
                            <Button x:Name="NextButton" Classes="tool" Content="›" FontSize="15" Padding="11,1" />
                            <Button x:Name="ConfigButton" Classes="tool" Content="配置" />
                            <Button x:Name="CloseButton" Classes="accent" Content="看完啦" />
                        </StackPanel>
                    </Grid>

                    <!-- ================= 正文 ================= -->
                    <Grid x:Name="BodyGrid" Grid.Row="1" Margin="26,4,26,0" ColumnDefinitions="1.06*,0.94*">

                        <!-- 左：一个巨大的数字 + 三个关键词。整块垂直居中，上下留白对称 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="DayLabel" Text="今天" FontSize="11"
                                           Opacity="0.55" FontFamily="Consolas, monospace" />
                                <TextBlock x:Name="LessonLabel" Text="" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                                <TextBlock x:Name="BigNumber" Text="0"
                                           FontSize="112" FontWeight="Bold"
                                           FontFamily="Georgia, Times New Roman, 宋体"
                                           LineHeight="116" />
                                <!-- 单位单独一个字号，112px 的"140 次"会把右边标签挤出去 -->
                                <TextBlock x:Name="BigUnit" Text="" IsVisible="False"
                                           FontSize="30" FontWeight="SemiBold" Opacity="0.72"
                                           VerticalAlignment="Bottom" Margin="0,0,0,22" />
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,18" Spacing="2">
                                    <TextBlock x:Name="BigLabel" Text="人睡着" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HeroHint" Text="" FontSize="11" Opacity="0.45" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="Headline" Text="" FontSize="14"
                                       TextWrapping="Wrap" LineHeight="22" Margin="0,6,0,0" Opacity="0.72" />

                            <TextBlock x:Name="Subline" Text="" FontSize="10.5"
                                       TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.46" />

                            <WrapPanel x:Name="StatsPanel" Margin="0,16,0,0" />
                        </StackPanel>

                        <!-- 右：曲线卡（入场时从零长起来） -->
                        <Grid x:Name="RightCol" Grid.Column="1" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Bottom">
                            <Border x:Name="ChartCard" CornerRadius="16" BorderThickness="1"
                                    BorderBrush="#22808080" Padding="12,10">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                        <TextBlock x:Name="ChartTitle" Text="人数变化" FontSize="11.5" FontWeight="SemiBold" Opacity="0.75" />
                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,1.5" Background="#22808080">
                                            <TextBlock x:Name="PeakBadge" Text="峰值 0 人" FontSize="10.5" />
                                        </Border>
                                    </Grid>
                                    <ctrl:SleepCurveChart x:Name="Chart" Grid.Row="1" MinHeight="196" />
                                </Grid>
                            </Border>

                            <Border x:Name="FactsHost" Grid.Row="1" CornerRadius="16" BorderThickness="1"
                                    BorderBrush="#22808080" Padding="14,11" Margin="0,10,0,0">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="FactsTitle" Text="记一笔" FontSize="11.5"
                                                   FontWeight="SemiBold" Opacity="0.75" />
                                        <TextBlock x:Name="FactsCount" Grid.Column="1" Text="0 条" FontSize="10.5"
                                                   Opacity="0.4" FontFamily="Consolas, monospace" />
                                    </Grid>
                                    <StackPanel x:Name="FactsPanel" Spacing="5" />
                                </StackPanel>
                            </Border>

                            <!-- 证据快照：默认折叠，点一下才展开缩略图 -->
                            <Border x:Name="SnapshotsHost" Grid.Row="2" CornerRadius="16" BorderThickness="1"
                                    BorderBrush="#22808080" Padding="14,9" Margin="0,10,0,0" IsVisible="False">
                                <StackPanel Spacing="7">
                                    <Button x:Name="SnapshotToggle" Background="Transparent" BorderThickness="0"
                                            Padding="0" HorizontalAlignment="Stretch" Cursor="Hand">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="SnapshotTitle" Text="证据快照" FontSize="11.5"
                                                       FontWeight="SemiBold" Opacity="0.75" />
                                            <TextBlock x:Name="SnapshotHint" Grid.Column="1" Text="点开看 ›"
                                                       FontSize="10.5" Opacity="0.45"
                                                       FontFamily="Consolas, monospace" />
                                        </Grid>
                                    </Button>
                                    <!-- 一排缩略图，横向滚。不做多行：卡片长高会把下面那块挤出窗口 -->
                                    <ScrollViewer x:Name="SnapshotScroller" IsVisible="False"
                                                  MaxHeight="96" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="SnapshotPanel" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================= 底栏 ================= -->
                    <Grid Grid.Row="2" Margin="26,8,26,14" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterNote" Grid.Column="1" Text="" FontSize="10.5" Opacity="0.4"
                                   Margin="14,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="PlayHint" Grid.Column="2" Text="自动轮播" FontSize="10.5" Opacity="0.42"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= 配置面板 ================= -->
            <Border x:Name="ConfigPanel" IsVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="420" Margin="0,8,8,8"
                    CornerRadius="18" BorderThickness="1" BorderBrush="#33808080"
                    Background="#FFFCF6" Padding="18">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="总结页配置" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="ConfigCloseButton" Grid.Column="1" Classes="tool" Content="收起" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">

                            <StackPanel Spacing="2">
                                <TextBlock Text="显示哪些内容" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <CheckBox x:Name="CbTotal" Content="睡觉总人数" />
                                    <CheckBox x:Name="CbCurve" Grid.Column="1" Content="人数变化曲线" />
                                    <CheckBox x:Name="CbRepeat" Grid.Row="1" Content="入睡次数" />
                                    <CheckBox x:Name="CbAwakened" Grid.Row="1" Grid.Column="1" Content="已睡醒人数" />
                                    <CheckBox x:Name="CbLongest" Grid.Row="2" Content="最长单次睡眠" />
                                    <CheckBox x:Name="CbPeak" Grid.Row="2" Grid.Column="1" Content="同时最多" />
                                    <CheckBox x:Name="CbFacts" Grid.Row="3" Content="趣味记录条目" />
                                    <CheckBox x:Name="CbHeadUp" Grid.Row="3" Grid.Column="1" Content="抬头率" />
                                    <CheckBox x:Name="CbSnapshots" Grid.Row="4" Content="证据快照" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="行为" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                    <CheckBox x:Name="CbSilent" Content="静默检测" />
                                    <CheckBox x:Name="CbAutoPopup" Grid.Column="1" Content="下课自动弹出" />
                                    <CheckBox x:Name="CbAutoPlay" Grid.Row="1" Content="逐日轮播" />
                                    <CheckBox x:Name="CbAutoClose" Grid.Row="1" Grid.Column="1" Content="末页自动关" />
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,12,2">
                                <TextBlock Text="每页停留" FontSize="12" VerticalAlignment="Center" Width="56" Opacity="0.8" />
                                <Slider x:Name="SlideSlider" Grid.Column="1" Margin="6,0" Minimum="3" Maximum="30"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="SlideValue" Grid.Column="2" Text="7s" FontSize="12" Width="30"
                                           FontFamily="Consolas, monospace" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,12,2">
                                <TextBlock Text="延迟弹出" FontSize="12" VerticalAlignment="Center" Width="56" Opacity="0.8" />
                                <Slider x:Name="DelaySlider" Grid.Column="1" Margin="6,0" Minimum="0" Maximum="120"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="DelayValue" Grid.Column="2" Text="0s" FontSize="12" Width="36"
                                           FontFamily="Consolas, monospace" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <StackPanel Spacing="5">
                                <TextBlock Text="配色" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55" />
                                <WrapPanel x:Name="PresetPanel" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,4,5,0">
                                        <TextBlock Text="背景" FontSize="11.5" Width="30" VerticalAlignment="Center" Opacity="0.75" />
                                        <TextBox x:Name="HexBackground" Classes="hex" Width="100" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
                                        <TextBlock Text="卡片" FontSize="11.5" Width="30" VerticalAlignment="Center" Opacity="0.75" />
                                        <TextBox x:Name="HexSurface" Classes="hex" Width="100" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,5,5,0">
                                        <TextBlock Text="主题" FontSize="11.5" Width="30" VerticalAlignment="Center" Opacity="0.75" />
                                        <TextBox x:Name="HexAccent" Classes="hex" Width="100" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                                        <TextBlock Text="文字" FontSize="11.5" Width="30" VerticalAlignment="Center" Opacity="0.75" />
                                        <TextBox x:Name="HexText" Classes="hex" Width="100" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="像素背景" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55" />
                                <CheckBox x:Name="CbPixel" Content="流动动画" />
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,12,0">
                                    <TextBlock Text="大小" FontSize="12" Width="56" VerticalAlignment="Center" Opacity="0.8" />
                                    <Slider x:Name="PixelSlider" Grid.Column="1" Margin="6,0" Minimum="4" Maximum="16"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PixelValue" Grid.Column="2" Text="7" FontSize="12" Width="30"
                                               FontFamily="Consolas, monospace" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,4">
                                <Button x:Name="SampleButton" Classes="tool" Content="换一版数据" />
                                <Button x:Name="FolderButton" Classes="tool" Content="历史文件位置" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="改完立刻生效，也会写进 summary.json。"
                               FontSize="11" Opacity="0.45" Margin="0,10,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
