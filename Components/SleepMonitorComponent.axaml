<ci:ComponentBase
    x:Class="ClassIsland.SleepWatch.Components.SleepMonitorComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:local="using:ClassIsland.SleepWatch.Components"
    x:TypeArguments="local:SleepMonitorSettings">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border x:Name="LevelDot"
                Width="9" Height="9"
                CornerRadius="5"
                VerticalAlignment="Center"
                Background="#4CAF50" />
        <TextBlock x:Name="MainText"
                   FontSize="15"
                   VerticalAlignment="Center"
                   Text="监测未启动" />
        <TextBlock x:Name="SubText"
                   FontSize="12"
                   Opacity="0.6"
                   VerticalAlignment="Center"
                   Text="" />
    </StackPanel>
</ci:ComponentBase>
